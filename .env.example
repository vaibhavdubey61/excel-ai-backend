# ==============================================================================
# Excel AI Coach - Environment Variables Configuration
# ==============================================================================

# Primary Google Gemini API Key for level-aware faculties and embeddings
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Secondary & Tertiary Gemini Keys for automatic 3-key pool rotation
GEMINI_API_KEY_SECONDARY=your_secondary_gemini_key_here
GEMINI_API_KEY_TERTIARY=your_tertiary_gemini_key_here

# Pinecone Serverless Cloud Vector Database
# Obtain from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_HOST=https://your-index-host.pinecone.io

# Optional: Multi-LLM OpenAI / ChatGPT Support (Dual-Provider Architecture)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
PREFERRED_LLM=gemini

# Local / Production Server Port
PORT=8000

# Admin Access Authentication Key (required for all /api/admin/* endpoints)
ADMIN_PASSWORD=admin123

# Database Connection URL (SQLite default, or PostgreSQL for external hosting)
# Default: sqlite:///data/app.db (Requires Render Persistent Disk mounted at /data)
DATABASE_URL=sqlite:///data/app.db

# Minimum Relevance Score for Grounded Material Matching
# Recommended calibrated value: 0.62 (Run python scripts/calibrate_threshold.py to calibrate)
MIN_SCORE=0.62

# 2-Stage RAG Cross-Encoder Reranker Configuration
# Lightweight model for CPU inference (e.g. cross-encoder/ms-marco-MiniLM-L-6-v2 or BAAI/bge-reranker-v2-m3)
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# Distributed Redis Rate Limiter Configuration
REDIS_URL=redis://localhost:6379/0
# Fail-open strategy: when false, allows traffic if Redis is unreachable; when true, strictly denies
STRICT_RATE_LIMIT=false
