# ==============================================================================
# Excel AI Coach - Environment Variables Configuration
# ==============================================================================

# Google Gemini API Key for level-aware faculties and embeddings
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone Serverless Cloud Vector Database
# Obtain from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_HOST=https://your-index-host.pinecone.io

# Local / Production Server Port
PORT=8000

# Admin Access Authentication Key (required for all /api/admin/* endpoints)
ADMIN_PASSWORD=admin123

# Database Connection URL (SQLite default, or PostgreSQL for external hosting)
# Default: sqlite:///data/app.db (Requires Render Persistent Disk mounted at /data)
DATABASE_URL=sqlite:///data/app.db

# Minimum Cosine Similarity Score for Grounded Material Matching
# Recommended calibrated value: 0.62 (Run python scripts/calibrate_threshold.py to calibrate)
MIN_SCORE=0.62
